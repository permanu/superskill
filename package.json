{
  "name": "superskill",
  "version": "0.16.0",
  "description": "One-entry orchestrator for coding agents: jailed vault, FTS knowledge graph, Obsidian-native architecture and code notes, 18-axis review. Curated packs — not a 90k-skill dump",
  "type": "module",
  "main": "dist/mcp-server.js",
  "bin": {
    "superskill": "dist/main.js",
    "superskill-cli": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/mcp-server.js",
      "default": "./dist/mcp-server.js"
    },
    "./cli": {
      "import": "./dist/cli.js",
      "default": "./dist/cli.js"
    }
  },
  "files": [
    "dist/",
    "!dist/**/*.test.js",
    "!dist/**/*.map",
    "!dist/**/*.d.ts",
    "!dist/**/__fixtures__/",
    "!dist/test-helpers.*",
    ".claude-plugin/",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md",
    "catalog/",
    "skills/",
    "assets/",
    "hooks/",
    "docs/harness.md",
    "docs/SKILL-TEMPLATE.md",
    "docs/authoring/CONTRACT.md"
  ],
  "scripts": {
    "build": "tsc && node scripts/vendor-grammars.mjs",
    "dev": "node scripts/vendor-grammars.mjs && tsc --watch",
    "start:mcp": "node dist/mcp-server.js",
    "start:cli": "node dist/cli.js",
    "pretest": "npm run build",
    "test": "vitest run",
    "pretest:coverage": "npm run build",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "lint": "tsc --noEmit",
    "validate:rules": "node dist/rules/cli.js validate",
    "validate:skills": "node scripts/check-skill-authoring.mjs",
    "verify:grammars": "node scripts/verify-grammars.mjs",
    "prepublishOnly": "npm run build",
    "postinstall": "node dist/setup/postinstall.js || true",
    "check:versions": "node scripts/check-versions.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "commander": "^13.1.0",
    "gray-matter": "^4.0.3",
    "web-tree-sitter": "0.24.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "tree-sitter-wasms": "0.1.13",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  },
  "license": "Apache-2.0",
  "author": "Permanu (Atharva Pandey)",
  "repository": {
    "type": "git",
    "url": "https://github.com/permanu/superskill.git"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "superskill",
    "knowledge-base",
    "ai",
    "cli",
    "agentic",
    "coding-agent",
    "claude",
    "cursor",
    "opencode",
    "codex"
  ],
  "engines": {
    "node": "^22.16.0 || >=24.0.0"
  }
}
